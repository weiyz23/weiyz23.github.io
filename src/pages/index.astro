---
// src/pages/index.astro
import '../styles/global.css';
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>Yunze Rixton Wei's Personal Page</title>
  </head>
  <body class="bg-gray-50 text-gray-800 font-sans antialiased">
    <main class="max-w-6xl mx-auto px-6 py-20">
      
      <!-- Intro Section -->
      <header class="flex flex-col items-start gap-4 mb-20 animate-fade-in-down">
        <!-- Avatar Placeholder -->
        <div class="w-24 h-24 bg-gradient-to-tr from-blue-500 to-purple-500 rounded-full shadow-lg"></div>
        
        <h1 class="text-4xl font-bold tracking-tight text-gray-900">
          Hello, I'm <span class="text-blue-600">Yunze Rixton Wei</span> 👋
        </h1>
        <p class="text-xl text-gray-600 leading-relaxed max-w-5xl">
          A Ph.D. Student specializing in Network Security and Measurement.
          <br />
          My research interests include <strong>Cyberspace Mapping</strong>, <strong>Internet Visibility</strong>, and <strong>Routing Security</strong>.
        </p>
        
        <!-- Social Links -->
        <div class="flex gap-6 mt-4">
          <a href="#" class="text-gray-500 hover:text-black transition-colors font-medium">GitHub</a>
          <a href="#" class="text-gray-500 hover:text-blue-400 transition-colors font-medium">Twitter</a>
          <a href="mailto:email@example.com" class="text-gray-500 hover:text-red-400 transition-colors font-medium">Email</a>
        </div>
      </header>

      <!-- Education Section -->
      <section class="mb-20">
        <h2 class="text-2xl font-bold mb-8 flex items-center gap-3">
          <span class="w-3 h-8 bg-purple-500 rounded-full"></span>
          Education
        </h2>
        <div class="space-y-6">
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center p-6 bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
            <div>
              <h3 class="text-lg font-bold text-gray-900">Ph.D. Student in Computer Science</h3>
              <p class="text-gray-500">Tsinghua University (Example)</p>
            </div>
            <span class="text-sm font-medium text-gray-400 px-3 py-1 bg-gray-50 rounded-full mt-2 sm:mt-0">2023 - Present</span>
          </div>
          <div class="flex flex-col sm:flex-row justify-between items-start sm:items-center p-6 bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md transition-shadow">
            <div>
              <h3 class="text-lg font-bold text-gray-900">B.S. in Information Security</h3>
              <p class="text-gray-500">University of Electronic Science and Technology (Example)</p>
            </div>
            <span class="text-sm font-medium text-gray-400 px-3 py-1 bg-gray-50 rounded-full mt-2 sm:mt-0">2019 - 2023</span>
          </div>
        </div>
      </section>

      <!-- Publications Section -->
      <section class="mb-20">
        <h2 class="text-2xl font-bold mb-8 flex items-center gap-3">
          <span class="w-3 h-8 bg-blue-500 rounded-full"></span>
          Publications
        </h2>
        
        <div class="grid gap-6">
          <!-- Publication 1 -->
          <a href="#" class="group block p-6 bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md hover:border-blue-100 transition-all duration-300">
            <div class="flex justify-between items-start mb-4">
              <h3 class="text-lg font-bold group-hover:text-blue-600 transition-colors line-clamp-2">Revealing the Invisible: A Global Measurement of IPv6 Routing Darkspace</h3>
              <span class="shrink-0 ml-4 text-xs font-bold px-2 py-1 bg-blue-50 text-blue-600 rounded-md">IMC 2025</span>
            </div>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">
              A large-scale measurement study characterizing the visibility of IPv6 prefixes and identifying hidden routing topologies worldwide.
            </p>
            <div class="flex gap-2 text-xs text-gray-400">
              <span class="bg-gray-50 px-2 py-1 rounded">Internet Measurement</span>
              <span class="bg-gray-50 px-2 py-1 rounded">IPv6</span>
            </div>
          </a>

          <!-- Publication 2 -->
          <a href="#" class="group block p-6 bg-white rounded-2xl border border-gray-100 shadow-sm hover:shadow-md hover:border-green-100 transition-all duration-300">
            <div class="flex justify-between items-start mb-4">
              <h3 class="text-lg font-bold group-hover:text-green-600 transition-colors line-clamp-2">SecureRoute: Detecting BGP Prefix Hijacking with Control Plane Anomalies</h3>
              <span class="shrink-0 ml-4 text-xs font-bold px-2 py-1 bg-green-50 text-green-600 rounded-md">USENIX Security 2024</span>
            </div>
            <p class="text-gray-600 text-sm leading-relaxed mb-4">
              Proposed a novel detection mechanism for BGP hijacking events by analyzing real-time control plane updates and AS path anomalies.
            </p>
            <div class="flex gap-2 text-xs text-gray-400">
              <span class="bg-gray-50 px-2 py-1 rounded">BGP Security</span>
              <span class="bg-gray-50 px-2 py-1 rounded">Network Security</span>
            </div>
          </a>
        </div>
      </section>

      <!-- Awards Section -->
      <section class="mb-20">
        <h2 class="text-2xl font-bold mb-8 flex items-center gap-3">
          <span class="w-3 h-8 bg-yellow-400 rounded-full"></span>
          Awards
        </h2>
        <div class="bg-white p-8 rounded-2xl border border-gray-100 shadow-sm">
            <ul class="space-y-6">
                <li class="flex items-start gap-4">
                    <div class="bg-yellow-50 p-2 rounded-lg text-yellow-500 text-xl">🏆</div>
                    <div>
                        <span class="block font-bold text-gray-900 text-lg">ACM SIGCOMM Student Travel Grant</span>
                        <p class="text-gray-500 mt-1">Awarded to attend the premier conference in data communication (2024).</p>
                    </div>
                </li>
                <li class="flex items-start gap-4">
                    <div class="bg-gray-50 p-2 rounded-lg text-gray-500 text-xl">🥈</div>
                    <div>
                        <span class="block font-bold text-gray-900 text-lg">National Scholarship</span>
                        <p class="text-gray-500 mt-1">Highest honor for graduate students (2024).</p>
                    </div>
                </li>
                 <li class="flex items-start gap-4">
                    <div class="bg-orange-50 p-2 rounded-lg text-orange-500 text-xl">🥉</div>
                    <div>
                        <span class="block font-bold text-gray-900 text-lg">Best Paper Award Nominee</span>
                        <p class="text-gray-500 mt-1">Internet Measurement Conference (IMC) 2025.</p>
                    </div>
                </li>
            </ul>
        </div>
      </section>

      <!-- Interests Section -->
      <section>
        <h2 class="text-2xl font-bold mb-8 flex items-center gap-3">
          <span class="w-3 h-8 bg-pink-500 rounded-full"></span>
          Interests
        </h2>
        <div class="flex flex-wrap gap-4">
            <span class="px-5 py-2 bg-white border border-gray-200 text-gray-700 rounded-full text-sm font-medium hover:border-pink-300 hover:text-pink-600 transition-colors cursor-default">📸 Photography</span>
            <span class="px-5 py-2 bg-white border border-gray-200 text-gray-700 rounded-full text-sm font-medium hover:border-blue-300 hover:text-blue-600 transition-colors cursor-default">☕ Specialty Coffee</span>
            <span class="px-5 py-2 bg-white border border-gray-200 text-gray-700 rounded-full text-sm font-medium hover:border-green-300 hover:text-green-600 transition-colors cursor-default">⛰️ Hiking</span>
            <span class="px-5 py-2 bg-white border border-gray-200 text-gray-700 rounded-full text-sm font-medium hover:border-purple-300 hover:text-purple-600 transition-colors cursor-default">🎮 Retro Gaming</span>
            <span class="px-5 py-2 bg-white border border-gray-200 text-gray-700 rounded-full text-sm font-medium hover:border-orange-300 hover:text-orange-600 transition-colors cursor-default">📚 Sci-Fi Reading</span>
        </div>
      </section>

      <footer class="mt-24 pt-10 border-t border-gray-100 text-center text-gray-400">
        <p class="mb-2">&copy; 2026 Yunze Rixton Wei. All rights reserved.</p>
        <p class="text-xs">Built with Astro & Tailwind CSS.</p>
      </footer>
    </main>
    
    <style>
      @keyframes fadeInDown {
        from { opacity: 0; transform: translateY(-10px); }
        to { opacity: 1; transform: translateY(0); }
      }
      .animate-fade-in-down {
        animation: fadeInDown 0.8s ease-out;
      }
    </style>
  </body>
</html>