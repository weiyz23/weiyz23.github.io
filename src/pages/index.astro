---
import '../styles/global.css';
import { Image } from 'astro:assets';
import ContactIcon from '../components/ContactIcon.astro';
import tsinghuaLogo from '../assets/tsinghua-logo.png';
import {
  profile,
  publicationGroups,
  researchProjects,
  technicalSkills,
  education,
  honors,
  service,
  interests,
} from '../data/profile';

const navigation = [
  { href: '#education', label: 'Education' },
  { href: '#publications', label: 'Publications' },
  { href: '#research', label: 'Research' },
  { href: '#honors', label: 'Honors' },
  { href: '#service', label: 'Service' },
  { href: '#beyond-research', label: 'Beyond research' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Yunze Wei (Rixton), Ph.D. student at Tsinghua University. Education, research in network security and graph computing, publications, student leadership, and music." />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href={`${import.meta.env.BASE_URL}favicon.svg`} />
    <title>Yunze Wei (Rixton) | Tsinghua University</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="page-width header-inner">
        <a class="home-link" href="#about">{profile.name}</a>
        <nav aria-label="Main navigation">
          {navigation.map((item) => <a href={item.href}>{item.label}</a>)}
        </nav>
      </div>
    </header>

    <main id="main-content" class="page-width">
      <section id="about" class="hero" aria-labelledby="name-heading">
        <div class="hero-heading">
          <h1 id="name-heading">{profile.name} <span class="name-alias">({profile.preferredName})</span><span class="chinese-name" lang="zh-CN">{profile.chineseName}</span></h1>
          <p class="affiliation">{profile.role}, {profile.university} · {profile.location}</p>
        </div>
        <img
          class="profile-photo"
          src={`${import.meta.env.BASE_URL}profile.jpg`}
          alt="Yunze Wei"
          width="150"
          height="200"
          style="height: auto;"
        />
        <p class="intro-detail">
          I am a {profile.role} at the <a href="https://www.insc.tsinghua.edu.cn/inscen/">{profile.institute}</a>,
          {profile.university}, advised by <a href={profile.advisor.url}>{profile.advisor.name}</a>,
          with research guidance from <a href={profile.researchMentor.url}>{profile.researchMentor.name}</a>.
          My research focuses on Internet measurement,
          observability, cyberspace mapping, and routing security, including Looking Glass service discovery
          and BGP anomaly detection.
        </p>
        <div class="contact-links" aria-label="Contact links">
          {profile.emails.map((email) => (
            <a class="contact-link" href={`mailto:${email}`}>
              <ContactIcon name="mail" />
              <span>{email}</span>
            </a>
          ))}
          <a class="contact-link" href={profile.github}>
            <ContactIcon name="github" />
            <span>GitHub</span>
          </a>
        </div>
      </section>

      <section id="education" class="content-section" aria-labelledby="education-heading">
        <div class="section-heading">
          <h2 id="education-heading">Education</h2>
        </div>
        <ol class="timeline education-list">
          {education.map((entry) => (
            <li>
              <p class="timeline-period">{entry.period}</p>
              <Image
                class="education-logo"
                src={tsinghuaLogo}
                alt={`${entry.school} emblem`}
                width={64}
                height={64}
                densities={[1, 2]}
                format="webp"
                loading="lazy"
                decoding="async"
              />
              <div class="timeline-body">
                <h3>{entry.degree}</h3>
                <p class="institution">{entry.department}, {entry.school}</p>
                {(entry.advisor || entry.researchMentor) && (
                  <p class="entry-detail">
                    {entry.advisor && (
                      <Fragment>Advisor: <a href={entry.advisor.url}>{entry.advisor.name}</a></Fragment>
                    )}
                    {entry.advisor && entry.researchMentor && ' · '}
                    {entry.researchMentor && (
                      <Fragment>Research mentor: <a href={entry.researchMentor.url}>{entry.researchMentor.name}</a></Fragment>
                    )}
                  </p>
                )}
                <p class="entry-detail">{entry.detail}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section id="publications" class="content-section" aria-labelledby="publications-heading">
        <div class="section-heading">
          <h2 id="publications-heading">Publications</h2>
        </div>
        <div class="publication-groups">
          {publicationGroups.map((group) => (
            <section aria-labelledby={group.id}>
              <h3 id={group.id} class="group-heading">{group.title}</h3>
              <ul class="paper-list">
                {group.papers.map((paper) => (
                  <li>
                    <article id={paper.id} class="paper">
                      <h4>
                        {paper.title}{' '}
                        {paper.url ? (
                          <a class="paper-link" href={paper.url} aria-label={`Webpage for ${paper.title}`}>
                            Webpage <span aria-hidden="true">↗</span>
                          </a>
                        ) : (
                          <button class="paper-link" type="button" disabled title="Paper webpage link not added yet" aria-label={`Webpage for ${paper.title} (link not added yet)`}>
                            Webpage <span aria-hidden="true">↗</span>
                          </button>
                        )}
                      </h4>
                      <p class="authors">
                        {paper.authors.map((author, index) => (
                          <Fragment>
                            {index > 0 && (index === paper.authors.length - 1 ? ', and ' : ', ')}
                            {author === profile.name ? <strong>{author}</strong> : author}
                          </Fragment>
                        ))}.
                      </p>
                      <div class="paper-meta">
                        <span class="paper-badge paper-badge-venue">{paper.venue}</span>
                        {paper.ratings.map((rating) => <span class="paper-badge">{rating}</span>)}
                      </div>
                    </article>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </section>

      <section id="research" class="content-section" aria-labelledby="research-heading">
        <div class="section-heading">
          <h2 id="research-heading">Research & engineering</h2>
        </div>
        <div class="project-grid">
          {researchProjects.map((project) => (
            <article class="project-card">
              <h3>{project.title}</h3>
              <div class="project-meta">{project.period}</div>
              <p>{project.description}</p>
            </article>
          ))}
        </div>
        <dl class="technical-skills" aria-label="Technical strengths">
          {technicalSkills.map((skill) => <div><dt>{skill.label}</dt><dd>{skill.detail}</dd></div>)}
        </dl>
      </section>

      <section id="honors" class="content-section" aria-labelledby="honors-heading">
        <div class="section-heading">
          <h2 id="honors-heading">Honors & awards</h2>
        </div>
        <ul class="honors-list">
          {honors.map((honor) => (
            <li>
              <time class="honor-year" datetime={honor.year}>{honor.year}</time>
              <div>
                <h3>{honor.title}</h3>
                <p lang="zh-CN" class="original-name">{honor.original}</p>
                <p class="honor-issuer">{honor.issuer}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>

      <section id="service" class="content-section" aria-labelledby="service-heading">
        <div class="section-heading">
          <h2 id="service-heading">Leadership & service</h2>
        </div>
        <ol class="timeline service-list">
          {service.map((entry) => (
            <li>
              <p class="timeline-period">{entry.period}</p>
              <div class="timeline-body">
                <h3>{entry.title}</h3>
                <p lang="zh-CN" class="original-name">{entry.original}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section id="beyond-research" class="content-section" aria-labelledby="beyond-heading">
        <div class="section-heading">
          <h2 id="beyond-heading">Beyond research</h2>
        </div>
        <div class="interests-grid">
          {interests.map((interest) => (
            <article class="interest-card">
              <h3>{interest.title}</h3>
              <p>
                {interest.organization && (
                  <Fragment>
                    {interest.role}{' '}
                    {interest.organization.url ? (
                      <a href={interest.organization.url}>{interest.organization.name}</a>
                    ) : (
                      <span class="link-placeholder" title="Choir website link not added yet">{interest.organization.name}</span>
                    )}{'. '}
                  </Fragment>
                )}
                {interest.description}
              </p>
            </article>
          ))}
        </div>
      </section>
    </main>

    <footer class="page-width site-footer">
      <div>
        <p class="footer-name">{profile.name} <span lang="zh-CN">{profile.chineseName}</span></p>
        <div class="footer-contact-links">
          {profile.emails.map((email) => (
            <a class="contact-link" href={`mailto:${email}`}>
              <ContactIcon name="mail" />
              <span>{email}</span>
            </a>
          ))}
        </div>
      </div>
      <p>© {new Date().getFullYear()} {profile.name}.<br />Built with Astro & Tailwind CSS.</p>
    </footer>
  </body>
</html>
